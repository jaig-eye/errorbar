{
  "name": "errorbar",
  "version": "0.1.0",
  "description": "A GitHub Action that runs a prompt or RAG eval suite on every pull request and fails the build only when quality drops by more than the noise can explain.",
  "keywords": [
    "llm",
    "eval",
    "evals",
    "rag",
    "prompt",
    "regression",
    "github-action",
    "ci",
    "bootstrap",
    "statistics"
  ],
  "license": "MIT",
  "author": "jaig-eye",
  "homepage": "https://github.com/jaig-eye/errorbar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaig-eye/errorbar.git"
  },
  "bugs": {
    "url": "https://github.com/jaig-eye/errorbar/issues"
  },
  "type": "module",
  "bin": {
    "errorbar": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "errorbar": "node dist/cli.js"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
